# Copy values into environment variables; this file is NOT loaded automatically.
# For Ollama use an already installed model identifier from `ollama list`.
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_MODEL=YOUR_INSTALLED_MODEL
LLM_API_KEY=
LLM_TIMEOUT=60
LLM_MAX_CALLS=80
LLM_MAX_TOKENS=700
# Ollama: max_tokens; OpenAI: max_completion_tokens. Auto-detected for port 11434.
LLM_TOKEN_PARAMETER=max_tokens
# Optional actual provider prices per million tokens (same currency).
LLM_INPUT_PRICE_PER_MILLION=
LLM_OUTPUT_PRICE_PER_MILLION=

