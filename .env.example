# Copy this file to .env in the project root; it is loaded automatically.
# Existing environment variables take priority. Restart after changing .env.
# For Ollama use an already installed model identifier from `ollama list`.
LLM_BASE_URL=https://api.giga.chat/v1
LLM_MODEL=GigaChat-2
LLM_API_KEY=
LLM_TOKEN_PARAMETER=max_tokens
LLM_MAX_TOKENS=8192
LLM_TIMEOUT=120
LLM_REASONING_EFFORT=
GIGACHAT_AUTH_KEY=your_authorization_key
GIGACHAT_SCOPE=GIGACHAT_API_PERS
LLM_CA_BUNDLE=runtime/certs/gigachat-ca.pem
