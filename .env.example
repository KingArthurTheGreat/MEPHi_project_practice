# Copy this file to .env in the project root; it is loaded automatically.
# Existing environment variables take priority. Restart after changing .env.
# For Ollama use an already installed model identifier from `ollama list`.
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_MODEL=YOUR_INSTALLED_MODEL
LLM_API_KEY=
LLM_TIMEOUT=60
LLM_MAX_CALLS=80
LLM_MAX_TOKENS=700
# Ollama: max_tokens; OpenAI: max_completion_tokens. Auto-detected for port 11434.
LLM_TOKEN_PARAMETER=max_tokens
# OpenRouter only: optional reasoning effort; none requires a model that can disable reasoning.
# LLM_REASONING_EFFORT=none
# Optional minimum seconds between API requests (0..60).
# OpenRouter :free models default to 3.1 seconds; other backends default to 0.
# LLM_REQUEST_INTERVAL=3.1
# Optional actual provider prices per million tokens (same currency).
LLM_INPUT_PRICE_PER_MILLION=
LLM_OUTPUT_PRICE_PER_MILLION=


# GigaChat: use these values instead of the Ollama settings above.
# LLM_BASE_URL=https://api.giga.chat/v1
# LLM_MODEL=GigaChat-2
# GIGACHAT_AUTH_KEY=your_authorization_key
# GIGACHAT_SCOPE=GIGACHAT_API_PERS
# Optional PEM CA bundle if required by your TLS environment:
# LLM_CA_BUNDLE=/absolute/path/to/ca-bundle.pem
